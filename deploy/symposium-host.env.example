# Symposium host env — EXAMPLE. Copy to /etc/symposium-host.env and fill in.
# ---------------------------------------------------------------------------
#   sudo cp deploy/symposium-host.env.example /etc/symposium-host.env
#   sudo chown root:root /etc/symposium-host.env
#   sudo chmod 600 /etc/symposium-host.env      # secrets — not world-readable
#
# NEVER commit the real filled-in file. This .example carries NO real secrets.
# ---------------------------------------------------------------------------

# 6-digit pairing code every friend must enter (x-symposium-code header).
# Generate a fresh one, e.g.:  shuf -i 100000-999999 -n 1
SYMPOSIUM_PAIRING_CODE=

# Admin token — ONLY its bearer may pull/delete/create models (x-symposium-admin
# header). Keep it long and secret; friends never see it. Generate, e.g.:
#   openssl rand -hex 24      (or)   head -c 32 /dev/urandom | base64
SYMPOSIUM_ADMIN_TOKEN=

# Supabase JWT secret (HS256) used to verify logged-in STUDENT tokens sent as
# `Authorization: Bearer <jwt>`. A valid, unexpired token upgrades a caller from
# guest (15/hr, small models only) to student (150/day, any model). Leave EMPTY
# to disable the student tier — Bearer-JWT holders then fall back to guest.
# This is the SAME value as the backend's SUPABASE_JWT_SECRET. Keep it secret.
SUPABASE_JWT_SECRET=

# Optional per-tier rate-limit overrides (defaults shown). Admins are unlimited.
# SYMPOSIUM_GUEST_PER_HOUR=15
# SYMPOSIUM_STUDENT_PER_DAY=150

# Where the local Ollama engine listens. Must stay loopback (matches ollama.service).
OLLAMA_HOST=127.0.0.1:11434
