# Symposium Lab env — copy to lab/.env and fill in. NEVER commit the real .env.
#   cp lab/.env.example lab/.env

# Hugging Face token — needed to download some base models (e.g. gated Llama).
# Get one at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# Where your Ollama engine listens (default local install).
OLLAMA_HOST=127.0.0.1:11434

# Admin token for the Symposium host proxy (matches deploy/symposium-host.env).
# Only its bearer may pull/delete models or trigger training remotely.
SYMPOSIUM_ADMIN_TOKEN=

# Optional: a remote Qdrant instead of the local on-disk store in rag_pipeline.py.
# Leave blank to use the zero-setup local ./ .qdrant folder.
QDRANT_URL=
QDRANT_API_KEY=
